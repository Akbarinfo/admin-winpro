{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared/ bo'limlarni bilmaydi: faqat shared ichidan import qiling."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**"],
                "message": "features/ faqat shared/ dan import qiladi."
              },
              {
                "group": ["@/features/**"],
                "message": "Boshqa feature'dan import qilmang (o'z feature'ingiz ichida nisbiy import ishlating). Umumiy kod shared/ ga ko'chiriladi."
              }
            ]
          }
        ]
      }
    }
  ]
}
